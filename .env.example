# ==============================================================================
# FoodRush API - Docker Compose & Spring Boot Environment Configuration
# ==============================================================================

# Nginx Reverse Proxy / API Gateway
NGINX_PORT=80

# PostgreSQL Database (Docker & Spring Boot)
POSTGRES_DB=foodrush_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/foodrush_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis Cache (Docker & Spring Boot)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Message Broker (Docker & Spring Boot; Management UI via Nginx /rabbitmq/)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Grafana Dashboard (Accessible via Nginx /grafana/)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# OpenCage Geocoder API Key
OPENCAGE_API_KEY=your_opencage_api_key_here

# JWT Security (Minimum 64 characters / 512 bits for HS512)
JWT_SECRET=change_this_to_a_strong_64_byte_secret_key_in_production_environment_2026
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Allowed Origin Patterns (comma-separated)
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://food-rush-web.vercel.app,https://*.vercel.app,https://foodrush-backend-production-b263bc5d.up.railway.app

# Mercado Pago Integration (Checkout Transparente Pix & Webhooks)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your_access_token_here
MERCADOPAGO_PUBLIC_KEY=APP_USR-your_public_key_here
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here
MERCADOPAGO_NOTIFICATION_URL=https://foodrush-backend-production-b263bc5d.up.railway.app/api/v1/payments/webhook
