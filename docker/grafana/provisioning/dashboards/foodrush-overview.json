        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.trade_name AS \"Restaurante\", CASE WHEN r.is_open THEN 'Aberto' ELSE 'Fechado' END AS \"Funcionamento\", COUNT(DISTINCT m.id) AS \"Pratos no Cardápio\", COUNT(DISTINCT o.id) AS \"Total de Pedidos\", COALESCE(SUM(o.total), 0) AS \"Receita Total\" FROM restaurants r LEFT JOIN menu_items m ON m.restaurant_id = r.id LEFT JOIN orders o ON o.restaurant_id = r.id GROUP BY r.id, r.trade_name, r.is_open ORDER BY \"Total de Pedidos\" DESC;",
          "refId": "A"
        }
      ],
      "title": "Desempenho por Restaurante (Pratos, Pedidos e Faturamento)",
      "type": "table"
